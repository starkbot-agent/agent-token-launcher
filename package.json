{
  "name": "agent-token-launcher",
  "version": "1.0.0",
  "description": "AI-powered token launcher for pump.fun - enables autonomous agents to create and deploy cryptocurrency tokens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-launch": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "crypto",
    "cryptocurrency",
    "token",
    "pumpfun",
    "solana",
    "ai",
    "agent",
    "autonomous",
    "launcher",
    "memecoin"
  ],
  "author": "StarkBot <starkbot@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/agent-token-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/agent-token-launcher/issues"
  },
  "homepage": "https://github.com/your-username/agent-token-launcher#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12",
    "jimp": "^0.22.10",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.1.4",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}